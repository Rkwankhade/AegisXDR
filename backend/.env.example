# AegisXDR Environment Configuration
# Copy this to .env and fill in values

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=aegisxdr-super-secret-key-change-in-production-32chars
DEBUG=true

# Database
DATABASE_URL=sqlite:///./aegisxdr.db
# For PostgreSQL: DATABASE_URL=postgresql://aegis:aegis123@localhost:5432/aegisxdr

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=aegisxdr-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# KMS
KMS_MASTER_KEY_PATH=./data/kms/master.key
KMS_KEY_STORE_PATH=./data/kms/keys/

# Vault
VAULT_STORAGE_PATH=./data/vault/
VAULT_MASTER_PASSWORD=change-this-vault-master-password

# PKI
PKI_ROOT_CA_PATH=./data/pki/root/
PKI_INTERMEDIATE_CA_PATH=./data/pki/intermediate/
PKI_CERTS_PATH=./data/pki/certs/

# Malware Vault
MALWARE_VAULT_PATH=./data/malware/
MALWARE_VAULT_KEY=change-this-malware-vault-encryption-key

# Threat Intel
THREAT_INTEL_FEEDS=./data/threat_intel/
THREAT_INTEL_SIGNING_KEY=./data/keys/threat_intel.key

# Forensics
FORENSICS_PATH=./data/forensics/
EVIDENCE_SIGNING_KEY=./data/keys/evidence.key

# Blockchain Audit
BLOCKCHAIN_STORE_PATH=./data/blockchain/

# Sandbox
SANDBOX_PATH=./data/sandbox/
SANDBOX_TIMEOUT=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AegisXDR@2024!

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# Multi-tenant
DEFAULT_TENANT=default
